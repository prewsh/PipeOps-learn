# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# env — never commit real secrets; .env.example is the documented contract
.env
.env.*
!.env.example

# testing
/e2e/artifacts/*
!/e2e/artifacts/.gitignore
/playwright-report/
/test-results/
/blob-report/
.playwright/

# supabase local stack
supabase/.branches/
supabase/.temp/

# editors + os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# typescript build cache
*.tsbuildinfo
# participant data is PII — never commit it
data/*.csv
data/*.tsv
